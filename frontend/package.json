{
  "name": "excelsior-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Excelsior OverPower deckbuilding companion - React SPA frontend (v2 rebuild).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "storybook": "node scripts/prepare-storybook-assets.mjs && storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "node scripts/prepare-storybook-assets.mjs && storybook build --output-dir storybook-static --disable-telemetry",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.1.0",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "10.6.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "postcss": "^8.5.18"
  }
}
