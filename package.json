    "migrate:validate": "ts-node src/scripts/flywayRunner.ts validate",
    "migrate:repair": "ts-node src/scripts/flywayRunner.ts repair",
    "migrate:docker": "bash scripts/flyway-docker.sh migrate",
    "migrate:docker:info": "bash scripts/flyway-docker.sh info",
    "migrate:docker:validate": "bash scripts/flyway-docker.sh validate",
    "migrate:docker:repair": "bash scripts/flyway-docker.sh repair",
