    "test:agentos-inheritance": "node --test tests/unit/agentos-inheritance-status.test.mjs",
    "lint": "eslint src tests --ext .ts",
    "find:unused": "knip",
    "find:unused:ci": "knip --production --include dependencies,duplicates"
